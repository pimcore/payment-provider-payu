{
  "name": "pimcore/payment-provider-payu",
  "license": "GPL-3.0+",
  "type": "pimcore-bundle",
  "description": "Pimcore Payment Provider - PayU",
  "config": {
    "sort-packages": true
  },
  "prefer-stable": true,
  "minimum-stability": "dev",
  "require": {
    "pimcore/ecommerce-framework-bundle": "^1.0",
    "pimcore/pimcore": "^11.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^1.9"
  },
  "autoload": {
    "psr-4": {
      "Pimcore\\Bundle\\PimcorePaymentProviderPayUBundle\\": "src/"
    }
  },
  "extra": {
    "pimcore": {
      "bundles": [
        "Pimcore\\Bundle\\PimcorePaymentProviderPayUBundle\\PimcorePaymentProviderPayUBundle"
      ]
    }
  }
}
